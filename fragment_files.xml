<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Передача файлов"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#2D3748"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/edit_file_path"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Путь к файлу"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_browse_file"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Обзор"
            android:backgroundTint="#4C51BF"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <Spinner
        android:id="@+id/spinner_target_node"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:background="@android:drawable/spinner_background"
        android:popupBackground="#FFFFFF" />

    <Button
        android:id="@+id/btn_send_file"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Отправить файл"
        android:backgroundTint="#2B6CB0"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="История передачи"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#4A5568"
        android:layout_marginBottom="12dp" />

    <ListView
        android:id="@+id/list_file_transfers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E2E8F0"
        android:dividerHeight="1dp"
        android:background="#FFFFFF"
        android:padding="8dp" />

</LinearLayout>
