<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="#FFFFFF"
    android:layout_marginVertical="4dp"
    android:elevation="1dp"
    android:outlineProvider="bounds"
    android:descendantFocusability="blocksDescendants">

    <TextView
        android:id="@+id/tv_node_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Устройство"
        android:textSize="16sp"
        android:textColor="#2D3748"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_node_address"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_node_name"
        android:text="192.168.1.10:8081"
        android:textSize="13sp"
        android:textColor="#4A5568" />

    <TextView
        android:id="@+id/tv_node_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_node_address"
        android:text="Недоступен"
        android:textSize="12sp"
        android:textColor="#E53E3E"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tv_node_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_node_status"
        android:text="Режим: авто"
        android:textSize="11sp"
        android:textColor="#A0AEC0"
        android:layout_marginTop="2dp" />

    <!-- ★ НОВОЕ: галочка выбора узла (вместо ToggleButton tb_gateway).
         Клик по галочке — выбор узла, клик по строке — меню действий. -->
    <ImageButton
        android:id="@+id/ib_select"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_radio_unchecked"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Выбрать узел"
        android:scaleType="centerInside"
        android:padding="10dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:clickable="true" />

</RelativeLayout>