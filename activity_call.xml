<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_call.xml — экран звонка CallActivity.

  Структура (FrameLayout):
    1. WebView (webview_call) — на весь экран. Сюда CallActivity через
       attachRetainedWebView() подставит retained sWebView (static, живёт
       вне Activity). Placeholder <WebView> нужен только чтобы findViewById
       вернул не-null и мы знали позицию в layout.
    2. Кнопка-переключатель чата (chat_btn_toggle) — правый нижний угол,
       поверх WebView.
    3. Оверлей чата (chat_overlay) — LinearLayout, скрыт по умолчанию:
       - шапка с кнопкой «свернуть» (chat_btn_close);
       - пустое состояние (chat_empty);
       - список сообщений (chat_list);
       - панель ввода: скрепка (chat_btn_attach), поле (chat_input),
         отправка (chat_btn_send).

  ★ Кнопка chat_btn_attach обязательна: без неё CallActivity.initChatViews()
    логирует warn и вложения в чате звонка недоступны (хотя pick-mode в
    FileManagerActivity полностью реализован).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ============================================================
         1. WebView звонка — на весь экран.
         ★ Placeholder: CallActivity.attachRetainedWebView() заменит его
         на retained sWebView (static). Если движок уже жив (reuse-ветка
         onCreate) — просто detach/attach без пересоздания.
         ============================================================ -->
    <WebView
        android:id="@+id/webview_call"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ============================================================
         2. Кнопка-переключатель чата (правый нижний угол, поверх WebView).
         ============================================================ -->
    <ImageButton
        android:id="@+id/chat_btn_toggle"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:src="@android:drawable/sym_action_chat"
        android:background="#CC6B46C1"
        android:contentDescription="Чат звонка"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:elevation="6dp" />

    <!-- ============================================================
         3. Оверлей чата (по умолчанию скрыт).
         ============================================================ -->
    <LinearLayout
        android:id="@+id/chat_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:paddingBottom="48dp"
        android:fitsSystemWindows="true"
        android:visibility="gone">

        <!-- Шапка оверлея -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#6B46C1"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💬 Чат звонка"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <ImageButton
                android:id="@+id/chat_btn_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Свернуть чат"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Пустое состояние чата -->
        <TextView
            android:id="@+id/chat_empty"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="center"
            android:text="💬 Нет сообщений\n\nНапишите первое сообщение"
            android:textSize="14sp"
            android:textColor="#718096"
            android:visibility="gone" />

        <!-- Список сообщений -->
        <ListView
            android:id="@+id/chat_list"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:transcriptMode="normal"
            android:background="#F0F4F8" />

        <!-- Панель ввода: скрепка + поле + отправка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- ★ Кнопка «Прикрепить» (скрепка). Без неё chat_btn_attach == null
                 в CallActivity.initChatViews() → вложения в чате звонка не работают. -->
            <ImageButton
                android:id="@+id/chat_btn_attach"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@android:drawable/ic_menu_attachment"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Прикрепить файл"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:visibility="visible" />

            <EditText
                android:id="@+id/chat_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:hint="Сообщение..."
                android:textSize="15sp"
                android:textColor="#2D3748"
                android:textColorHint="#A0AEC0"
                android:background="@android:drawable/edit_text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:maxLines="4"
                android:inputType="textMultiLine|textCapSentences"
                android:imeOptions="actionSend" />

            <ImageButton
                android:id="@+id/chat_btn_send"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:src="@android:drawable/ic_menu_send"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Отправить"
                android:scaleType="centerInside"
                android:padding="8dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>