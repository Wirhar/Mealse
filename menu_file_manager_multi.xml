    <item
        android:id="@+id/fm_multi_select_all"
        android:title="Выбрать всё"
        android:icon="@drawable/ic_check"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/fm_multi_download"
        android:title="Скачать"
        android:icon="@drawable/ic_download"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/fm_multi_copy"
        android:title="Копировать"
        android:icon="@drawable/ic_file_generic"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/fm_multi_move"
        android:title="Переместить"
        android:icon="@drawable/ic_folder"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/fm_multi_paste"
        android:title="Вставить"
        android:icon="@drawable/ic_paste"
        app:showAsAction="ifRoom" />

    <!-- ★ НОВОЕ: сжатие выбранных файлов/папок в .zip.
         Видимость управляется в MultiActionMode.onPrepareActionMode —
         только для локального источника (для удалённых узлов
         сжатие требовало бы серверной поддержки). -->
    <item
        android:id="@+id/fm_multi_compress"
        android:title="Сжатие"
        android:icon="@drawable/ic_file_archive"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/fm_multi_delete"
        android:title="Удалить"
        android:icon="@drawable/ic_delete"
        app:showAsAction="ifRoom" />

    <!-- ★ НОВОЕ (pick-mode): подтвердить выбор и вернуть пути в чат.
         Видимость: только при pickMode == true (см. onPrepareActionMode).
         По клику → pickReturnSelection(false) → returnPickedPaths → finish. -->
    <item
        android:id="@+id/fm_multi_pick_done"
        android:title="✓ Выбрать"
        android:icon="@drawable/ic_check"
        app:showAsAction="ifRoom"
        android:visible="false" />

    <!-- ★ НОВОЕ (pick-mode): собрать выбранное в один ZIP и вернуть его в чат.
         Видимость: только при pickMode == true (см. onPrepareActionMode).
         По клику → pickReturnSelection(true) → ZipCompressor.showSingleZipDialogAndCompress
         → возврат одного zip-файла в чат. -->
    <item
        android:id="@+id/fm_multi_pick_zip"
        android:title="🗜 В ZIP"
        android:icon="@drawable/ic_file_archive"
        app:showAsAction="ifRoom"
        android:visible="false" />

</menu>