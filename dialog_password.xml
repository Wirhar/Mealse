<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Короткое название сайта"
        android:textColor="#718096"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/pw_edit_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Например: ВК, Госуслуги"
        android:inputType="text"
        android:textColor="#2D3748"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Логин"
        android:textColor="#718096"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/pw_edit_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="user@example.com"
        android:inputType="textEmailAddress"
        android:textColor="#2D3748"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Пароль"
        android:textColor="#718096"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/pw_edit_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="••••••••"
        android:inputType="textPassword"
        android:textColor="#2D3748"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="URL (необязательно)"
        android:textColor="#718096"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/pw_edit_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="https://example.com"
        android:inputType="textUri"
        android:textColor="#2D3748" />

</LinearLayout>