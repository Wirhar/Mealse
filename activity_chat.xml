<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F0F4F8">

    <!-- Шапка -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/ch_btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Назад"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/ch_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Диалог"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#2D3748"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/ch_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#718096"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/ch_btn_info"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_info_details"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Информация"
            android:scaleType="centerInside"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Индикатор загрузки -->
    <ProgressBar
        android:id="@+id/ch_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <!-- Пустой чат -->
    <TextView
        android:id="@+id/ch_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="💬 Нет сообщений\n\nНапишите первое сообщение"
        android:textSize="15sp"
        android:textColor="#718096"
        android:visibility="gone" />

    <!-- Список сообщений (reverse layout — новые снизу) -->
    <ListView
        android:id="@+id/ch_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:transcriptMode="normal"
        android:visibility="visible" />

    <!-- Панель ввода -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:elevation="4dp">

        <!-- ★ НОВОЕ: скрепка -->
        <ImageButton
            android:id="@+id/ch_btn_attach"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_attachment"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Прикрепить файл"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <EditText
            android:id="@+id/ch_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:hint="Сообщение..."
            android:textSize="15sp"
            android:textColor="#2D3748"
            android:textColorHint="#A0AEC0"
            android:background="@android:drawable/edit_text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:maxLines="5"
            android:inputType="textMultiLine|textCapSentences"
            android:imeOptions="actionSend" />

        <ImageButton
            android:id="@+id/ch_btn_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Отправить"
            android:scaleType="centerInside"
            android:padding="8dp" />
    </LinearLayout>

</LinearLayout>
