<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.my.mealse"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- ============================================================
         SDK
         ============================================================ -->
    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="35" />

    <!-- ============================================================
         Основные разрешения
         ============================================================ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- BackgroundReceiver: BOOT_COMPLETED -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ============================================================
         Foreground services
         ============================================================ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ============================================================
         Уведомления и звонки
         ============================================================ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- ============================================================
         Камера / микрофон
         ============================================================ -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- ============================================================
         Wi-Fi Direct
         ============================================================ -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />

    <uses-feature
        android:name="android.hardware.wifi.direct"
        android:required="false" />

    <!-- ============================================================
         Хранилище (для файлового менеджера и логов)
         ============================================================ -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- ============================================================
         Feature-флаги
         ============================================================ -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <!-- ============================================================
         APPLICATION
         ============================================================ -->
    <application
        android:name=".MealseApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_meals5"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_meals5"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.MyApplication">

        <!-- ============================================================
             Activities
             ============================================================ -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Mealse.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Mealse.NoActionBar" />

        <!-- ============================================================
             ★ CallActivity: УБРАН taskAffinity=""
             
             БЫЛО:  android:taskAffinity=""
             СТАЛО: (атрибут удалён)

             Причина: с taskAffinity="" CallActivity жила в отдельной
             task, не связанной с основной task приложения. При запуске
             FileManagerActivity (основная task) система — особенно
             MIUI/HyperOS с агрессивным менеджером памяти — уничтожала
             фоновую task CallActivity как «лишнюю» → onDestroy →
             sendBye → звонок рвался на обеих сторонах (в логе:
             onDestroy isFinishing=true → bye, при том что пользователь
             лишь открыл файловый менеджер).

             Теперь CallActivity в основной task приложения: переход
             в FileManagerActivity и обратно её не убивает.

             Для IncomingCallActivity taskAffinity="" ОСТАВЛЕН —
             там это оправдано (входящий звонок поверх lock screen,
             отдельная task, не должна смешиваться с основной).
             ============================================================ -->
        <activity
            android:name=".CallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Mealse.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density" />

        <!-- Входящий звонок.
             taskAffinity="" СОХРАНЁН (отдельная task поверх lock screen).
             excludeFromRecents="true", turnScreenOn="true" — как было. -->
        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density" />

        <activity
            android:name=".TunnelActivity"
            android:exported="false"
            android:label="VPN"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".WifiDirectActivity"
            android:exported="false"
            android:label="Wi-Fi Direct"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".filemanager.ui.FileManagerActivity"
            android:exported="false"
            android:label="@string/file_manager_title"
            android:parentActivityName=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Mealse.FileManager" />

        <activity
            android:name=".filemanager.ui.TrashActivity"
            android:exported="false"
            android:label="Корзина"
            android:parentActivityName=".filemanager.ui.FileManagerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Mealse.FileManager" />

        <activity
            android:name=".filemanager.viewer.ImagePreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.Mealse.Fullscreen"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".filemanager.viewer.MAS_VideoPlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="sensor"
            android:theme="@style/Theme.Mealse.Fullscreen"
            android:parentActivityName=".filemanager.ui.FileManagerActivity" />

        <activity
            android:name=".filemanager.viewer.MAS_TextEditor"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:theme="@style/TextEditorTheme" />

        <activity
            android:name=".browser.BrowserActivity"
            android:exported="false"
            android:label="Браузер"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:theme="@style/Theme.Mealse.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <activity
            android:name=".browser.HistoryActivity"
            android:exported="false"
            android:label="История"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:theme="@style/Theme.Mealse.NoActionBar" />

        <activity
            android:name=".browser.SavedSitesActivity"
            android:exported="false"
            android:label="Сохранённые сайты"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:theme="@style/Theme.Mealse.NoActionBar" />

        <activity
            android:name=".browser.PasswordManagerActivity"
            android:exported="false"
            android:label="Пароли"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:theme="@style/Theme.Mealse.NoActionBar" />

        <activity
            android:name=".browser.BrowserSettingsActivity"
            android:exported="false"
            android:label="Настройки браузера"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density"
            android:theme="@style/Theme.Mealse.NoActionBar" />

        <activity
            android:name=".messenger.ui.ChatsListActivity"
            android:exported="false"
            android:label="Сообщения"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".messenger.ui.ChatActivity"
            android:exported="false"
            android:label="Чат"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- ============================================================
             Services
             ============================================================ -->

        <service
            android:name=".service.ServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".service.ConnectionManager"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".service.TunnelVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN tunnel for Mealse peer-to-peer network" />
        </service>

        <service
            android:name=".filemanager.server.RemoteFsService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- ============================================================
             Receivers
             ============================================================ -->

        <receiver
            android:name=".receiver.BackgroundReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED"
            android:directBootAware="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.net.wifi.WIFI_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- ============================================================
             Provider
             ============================================================ -->

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
