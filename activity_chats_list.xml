<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4F8">

    <!-- Шапка -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/cl_btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Назад"
            android:scaleType="centerInside"
            android:padding="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Сообщения"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2D3748" />

        <!-- Кнопка создания нового чата -->
        <ImageButton
            android:id="@+id/cl_btn_new"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_input_add"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Новый чат"
            android:scaleType="centerInside"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Индикатор загрузки -->
    <ProgressBar
        android:id="@+id/cl_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <!-- Пустой список -->
    <TextView
        android:id="@+id/cl_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:gravity="center"
        android:text="💬 Нет диалогов\n\nНажмите «+», чтобы начать переписку"
        android:textSize="15sp"
        android:textColor="#718096"
        android:visibility="gone" />

    <!-- Список диалогов -->
    <ListView
        android:id="@+id/cl_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="#E2E8F0"
        android:dividerHeight="1dp"
        android:background="#FFFFFF"
        android:visibility="visible" />

</LinearLayout>